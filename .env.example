# Copy this file to .env and fill in your own values
DB_HOST=localhost
DB_PORT=3306
DB_NAME=agrismart
# application user (created by scripts/setup_database.py)
DB_USER=agrismart
DB_PASSWORD=agrismart123
# MySQL admin account - only used once by setup_database.py
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=your_mysql_root_password

FLASK_SECRET_KEY=replace-with-any-random-string
# Arduino serial port: Windows -> COM3 / COM4 ..., Linux -> /dev/ttyACM0
SERIAL_PORT=COM3
SERIAL_BAUD=9600
# vwc = sketch sends soil water content; relative = sketch sends 0-100 % (100 % -> MOISTURE_SAT_VWC)
MOISTURE_SCALE=vwc
MOISTURE_SAT_VWC=45
RECOMMEND_WINDOW_DAYS=7
